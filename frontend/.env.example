# ============================================================
# Prahari Frontend — Environment Variables Template
# ============================================================
# Copy this file to .env or .env.local and populate the values.
# NEVER commit .env files to version control.

# --- Supabase Configuration (Optional for Local/Mock Mode) ---
# If left empty or using placeholders, the app will run in a
# high-fidelity local sandbox mode with simulated authentication
# and mock data syncing.

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
